# FilmWeaver 后端环境变量示例。复制为 .env 后填入真实值（.env 不入库）。
FW_ENV=dev
FW_HOST=127.0.0.1
FW_PORT=8002

# OpenAI 兼容网关（zx1.deepwl.net，与 drama 系列共用；原 kegeai 网关已失联）
FW_GATEWAY_BASE_URL=https://zx1.deepwl.net/v1
# 文本/视频通道 KEY（勿提交入库）
FW_GATEWAY_API_KEY=
# 图像通道独立 KEY（gpt-image-2 渠道）；留空回退 FW_GATEWAY_API_KEY
FW_IMAGE_API_KEY=

# 默认模型（缺省即以下值）
FW_LLM_MODEL=gemini-3.6-flash
FW_IMAGE_MODEL=gpt-image-2
FW_VIDEO_MODEL=veo-3-1-fast

FW_DEFAULT_CONCURRENCY=8
FW_REQUEST_TIMEOUT=120

# ---- RunningHub（ComfyUI 工作流平台）：MiniMax H3 参考图生视频 ----
# 填了 KEY 才会注册 minimax-h3-ref2v 通道；留空则该通道不出现在 /v2/models。
FW_RUNNINGHUB_BASE_URL=https://www.runninghub.cn
FW_RUNNINGHUB_API_KEY=
# MiniMax H3 Reference-to-Video 工作流 id（默认值已内置，一般无需覆盖）
FW_RUNNINGHUB_H3_WORKFLOW_ID=2084464684937342977
# 机型档位：留空=默认机；plus=48G(1.5×价)；ultra=84G（当前账号未开通）
# 注意：传非法值平台会静默降级到默认机，不报错。
FW_RUNNINGHUB_INSTANCE_TYPE=
# ---- H3 各生成模式的工作流 id（留空=该模式不可用，UI 置灰）----
# 首帧(I2VA)/首尾帧(FL2VA)/尾帧(L2VA) 官方支持，待提供对应 RunningHub 工作流后填入即自动开通：
FW_RUNNINGHUB_H3_I2VA_WORKFLOW_ID=
FW_RUNNINGHUB_H3_FL2VA_WORKFLOW_ID=
FW_RUNNINGHUB_H3_L2VA_WORKFLOW_ID=

# ---- 可选 API Token（数据安全）: 设置即启用, 所有 /v2 写操作需带 Header X-FW-Token ----
# 桌面端在 localStorage.fw_api_token 配同一值; 不设置保持开放(dev 默认)
FW_API_TOKEN=

# ---- 登录体系（复用主平台用户数据）: 设置即启用 ----
# dev = drama-dev orchestrator; 未来上线 prod 改为 prod 地址即可（用户数据自动对应）
FW_AUTH_UPSTREAM=http://127.0.0.1:8001

# LLM 输出上限: >0 显式随请求带 max_tokens(顶掉网关可能偏小的默认值); =0 省略走网关默认
# 注: 协议无"无限"取值, 每个模型都有输出硬上限; 防截断根本靠输入分块
FW_LLM_MAX_TOKENS=16384

# ---- 火山方舟 Seedance 2.0 / 2.0 mini（配置 KEY+EP 即自动注册）----
FW_ARK_API_KEY=
FW_SEEDANCE_EP=
FW_SEEDANCE_MINI_EP=

# ---- 视频生成并发与重试（全局池, 所有job/用户共用）----
FW_VIDEO_CONCURRENCY=300
FW_VIDEO_RETRIES=2
FW_VIDEO_RETRY_BACKOFF=5.0
